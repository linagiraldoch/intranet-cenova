rules_version = '2';

// Reglas de seguridad de la Intranet Cenova.
// Todo está cerrado por defecto: solo los correos del equipo, con sesión iniciada,
// pueden leer o escribir. Nadie más (ni con la página abierta) ve un solo dato.
service cloud.firestore {
  match /databases/{database}/documents {

    function equipo() {
      return request.auth != null
        && request.auth.token.email in [
          'gerencia@cenovasas.com',
          'aberrocal@cenovasas.com',
          'jcantillo@cenovasas.com'
        ];
    }
    function admin() {
      return equipo() && request.auth.token.email == 'gerencia@cenovasas.com';
    }
    // Los números de registro (COT-xxxx, OC-xxxx) no se pueden cambiar una vez asignados.
    function numeroIntacto() {
      return !('numero' in resource.data) || resource.data.numero == null || resource.data.numero == ''
        || request.resource.data.numero == resource.data.numero;
    }

    // Perfil de cada persona: solo se edita el suyo (tema, cambio de clave, último ingreso).
    match /usuarios/{uid} {
      allow read: if equipo();
      allow create, update: if equipo() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['usuario','nombre','email','tema','debeCambiarClave','creadoEn','ultimoIngreso','claveCambiadaEn']);
      allow delete: if false;
    }

    match /cotizaciones/{id} {
      allow read, create: if equipo();
      allow update: if equipo() && numeroIntacto();
      allow delete: if equipo();
    }

    // Las órdenes de compra no se borran (registro legal): se anulan cambiando su estado.
    match /ordenesCompra/{id} {
      allow read, create: if equipo();
      allow update: if equipo() && numeroIntacto();
      allow delete: if admin();
    }

    match /proyectos/{id}             { allow read, write: if equipo(); }
    match /eventos/{id}               { allow read, write: if equipo(); }
    match /clientes/{id}              { allow read, write: if equipo(); }
    match /cotizacionesProveedor/{id} { allow read, write: if equipo(); }

    // Cualquier otra colección: cerrada.
    match /{document=**} { allow read, write: if false; }
  }
}
